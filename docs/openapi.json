              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/signals/{sid}": {
      "get": {
        "summary": "Detail",
        "operationId": "detail_api_signals__sid__get",
